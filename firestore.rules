rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validating document structures
    function isValidEvidence(data) {
      return data.sha256Hash is string
        && data.inputType is string
        && data.verdict is string
        && data.trustScore is int;
    }

    function isValidFeedback(data) {
      return data.feedbackId is string
        && data.sha256Hash is string
        && data.userFeedback is string;
    }

    // 1. Evidence Vault Collection
    // - Reads: Restricted to authenticated users only.
    // - Writes: Allow authenticated uploaders with validated fields.
    match /evidence_vault/{hash} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.sha256Hash == hash
                    && isValidEvidence(request.resource.data);
      allow update: if request.auth != null 
                    && request.resource.data.sha256Hash == hash 
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reuseCount', 'scanCount', 'lastSeen', 'helpfulCount', 'notHelpfulCount', 'feedbackCount', 'repeatedMisinfoCount']));
    }

    // 2. User Feedback Collection
    // - Reads: Blocked for general clients; restricted to admin accounts.
    // - Writes: Authenticated users can submit feedback.
    match /user_feedback/{feedbackId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.auth != null 
                    && request.resource.data.feedbackId == feedbackId
                    && isValidFeedback(request.resource.data);
    }

    // 3. Announcements Collection
    // - Reads: Publicly readable for Home Screen banner alerts.
    // - Writes: Admin only.
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 4. Users (Active Sessions & limits log)
    // - Reads & Writes: strictly restricted to the owning authenticated user.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. Top Queries
    // - Reads: Publicly readable.
    // - Writes: Locked to clients. Cloud Functions (Admin SDK) only.
    match /top_queries/{queryId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. Analytics Stats (Vault statistics & system health)
    // - Reads: Publicly readable.
    // - Writes: Locked to clients. Cloud Functions (Admin SDK) only.
    match /analytics/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
