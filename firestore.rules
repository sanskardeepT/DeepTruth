rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Evidence Vault Collection
    // - Reads: Publicly readable so any installation can read cached hashes.
    // - Writes: Allow authenticated uploader or fallback anonymous ID updates (incrementing reuse counts).
    match /evidence_vault/{hash} {
      allow read: if true;
      allow create: if request.resource.data.sha256Hash == hash;
      allow update: if request.resource.data.sha256Hash == hash 
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reuseCount', 'lastSeen', 'helpfulCount', 'notHelpfulCount', 'feedbackCount', 'repeatedMisinfoCount']));
    }

    // 2. User Feedback Collection
    // - Reads: Blocked for general users; restricted to admin accounts.
    // - Writes: Anyone can submit a rating/comment feedback item.
    match /user_feedback/{feedbackId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.resource.data.feedbackId == feedbackId;
    }

    // 3. Announcements Collection
    // - Reads: Publicly readable for Home Screen banner alerts.
    // - Writes: Strictly writeable by administrators only.
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 4. Users (Active Sessions log)
    // - Reads: Authenticated admin or owner.
    // - Writes: Allow registration/updates matching the anonymous ID or User ID.
    match /users/{userId} {
      allow read, write: if true; // In production, replace with: if request.auth != null && request.auth.uid == userId;
    }

    // 5. Top Queries
    // - Reads: Publicly readable.
    // - Writes: Allow incrementing check count.
    match /top_queries/{queryId} {
      allow read: if true;
      allow create, update: if true;
    }

    // 6. Analytics Stats (Vault statistics & system health)
    // - Reads: Publicly readable by Admin screen.
    // - Writes: Allow updates to counters from clients.
    match /analytics/{docId} {
      allow read: if true;
      allow create, update: if true;
    }
  }
}
